# Mantis LLM credentials template
# =====================================
# Copy this file to `reference/.env` (or the repo-root `.env`) and fill in your
# API keys. The `.env` file is git-ignored, so your secrets never get committed.
#
#   cp reference/.env.example reference/.env
#
# Existing process environment variables always take precedence over this file,
# so you can also export these vars in your shell instead.

# -----------------------------------------------------------------------------
# Ollama Cloud (required for `:cloud` models, e.g. ollama/deepseek-v4-flash:cloud)
# -----------------------------------------------------------------------------
# Get your key from: https://ollama.com/settings/keys
OLLAMA_API_KEY=

# -----------------------------------------------------------------------------
# OpenAI-compatible endpoints (openai/<model> via vLLM, LM Studio, Ollama Cloud /v1)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Anthropic (only when using anthropic/<model> directly)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Gemini / Google AI Studio (only when using gemini/<model> with GEMINI_API_KEY)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# LLM_API_BASE=                     # optional; overrides auto-resolved endpoints
# LLM_TIMEOUT=                      # optional; per-request timeout in seconds
